---
// Layout for the plain, crawlable sub-pages (about, resume, project case studies).
// No preloader, WebGL or scroll-jacking: fast, text-first pages that rank on their own and link back home.
import Base from './Base.astro';
import { person, site, projects } from '../data/profile';
import { hasPosts } from '../lib/blog';

interface Props {
  title: string;
  description: string;
  /** Breadcrumb trail after "Home", e.g. [{ name: 'Projects', path: '/projects/' }, { name: 'VAIL-Plant' }]. */
  crumbs: { name: string; path?: string }[];
  schema?: Record<string, unknown>[];
  ogType?: string;
  noindex?: boolean;
  image?: string;
  imageAlt?: string;
}
const { title, description, crumbs, schema = [], ogType = 'website', noindex = false, image, imageAlt } = Astro.props;

const here = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const trail = [{ name: person.name, path: '/' }, ...crumbs.map((c) => ({ ...c, path: c.path ?? here }))];
const breadcrumb = {
  '@type': 'BreadcrumbList',
  '@id': `${new URL(here, site.url).href}#breadcrumb`,
  itemListElement: trail.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: new URL(c.path, site.url).href,
  })),
};

const links = [
  { href: '/about/', label: 'About' },
  { href: '/resume/', label: 'Resume' },
  { href: '/projects/', label: 'Projects' },
  ...((await hasPosts()) ? [{ href: '/blog/', label: 'Blog' }] : []),
  { href: '/#contact', label: 'Contact' },
];
const year = new Date().getFullYear();
---
<Base title={title} description={description} schema={[breadcrumb, ...schema]} ogType={ogType} noindex={noindex} image={image} imageAlt={imageAlt}>
  <slot name="head" slot="head" />
  <header class="pg-nav">
    <div class="container pg-nav-inner">
      <a href="/" class="brand" aria-label={`${person.name} — home`}>
        <span class="brand-mark" aria-hidden="true">AA</span>
        <span class="brand-name">{person.name} <span>/ {person.role}</span></span>
      </a>
      <nav aria-label="Primary" class="pg-links mono">
        {links.map((l) => <a href={l.href} aria-current={here === l.href || (l.href !== '/' && here.startsWith(l.href)) ? 'page' : undefined}>{l.label}</a>)}
      </nav>
    </div>
  </header>

  <main id="main" class="pg">
    <div class="container pg-body">
      <nav aria-label="Breadcrumb" class="pg-crumbs mono">
        <ol>
          {trail.map((c, i) => (
            <li>{i < trail.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
          ))}
        </ol>
      </nav>
      <slot />
    </div>
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-top mono">
        <span>{person.name} · {person.role} · {person.location}</span>
        <nav aria-label="Footer">
          <a href="/">Home</a>
          <a href="/about/">About</a>
          <a href="/resume/">Resume</a>
          {links.some((l) => l.href === '/blog/') && <a href="/blog/">Blog</a>}
          {projects.map((p) => <a href={`/projects/${p.id}/`}>{p.title}</a>)}
          <a href={`mailto:${person.email}`}>Email</a>
          <a href={person.linkedin} target="_blank" rel="me noopener">LinkedIn</a>
        </nav>
      </div>
      <div class="footer-bottom mono" style="margin-top:28px">
        <span>© {year} {person.name}</span>
        <a href={site.cv} download>Download CV (PDF) ↓</a>
      </div>
    </div>
  </footer>
</Base>

<style is:global>
  .pg-nav { position: sticky; top: 0; z-index: 50; background: rgba(10, 10, 11, 0.86); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .pg-nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: var(--nav-h); flex-wrap: wrap; padding-block: 10px; }
  .pg-links { display: flex; flex-wrap: wrap; gap: 6px 20px; color: var(--muted); }
  .pg-links a:hover, .pg-links a[aria-current] { color: var(--ink); }
  .pg-body { max-width: 920px; padding-block: clamp(40px, 8vw, 96px); }
  .pg-crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; color: var(--dim); margin-bottom: 36px; }
  .pg-crumbs li + li::before { content: '/'; margin-right: 6px; }
  .pg-crumbs a:hover { color: var(--ink); }
  .pg h1 { font-family: var(--f-display); font-size: clamp(38px, 7vw, 76px); line-height: 1; letter-spacing: -0.03em; text-transform: uppercase; font-variation-settings: 'wdth' 90; margin-bottom: 22px; }
  .pg h1 .serif { text-transform: none; color: var(--accent); }
  .pg h2 { font-family: var(--f-display); font-size: clamp(24px, 3.4vw, 34px); letter-spacing: -0.02em; margin: 56px 0 18px; }
  .pg h3 { font-size: 20px; margin: 28px 0 6px; }
  .pg p, .pg li { color: var(--ink-2); }
  .pg p + p { margin-top: 14px; }
  .pg .lede { font-size: clamp(19px, 2.2vw, 23px); color: var(--ink); line-height: 1.5; }
  .pg ul { padding-left: 20px; display: grid; gap: 8px; margin-top: 10px; }
  .pg .meta { color: var(--muted); margin-top: 4px; }
  .pg .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; padding: 0; list-style: none; }
  .pg .pg-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .pg .pg-cards { list-style: none; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .pg .pg-cards a { display: block; height: 100%; padding: 22px; border: 1px solid var(--line-2); border-radius: var(--radius); background: var(--surface); transition: border-color 0.2s; }
  .pg .pg-cards a:hover { border-color: var(--accent); }
  .pg .pg-cards strong { display: block; font-size: 20px; margin: 8px 0 6px; }
  .pg dl { display: grid; grid-template-columns: max-content 1fr; gap: 8px 24px; }
  .pg dt { color: var(--muted); }

  /* ---- blog ---- */
  .post-list { list-style: none; padding: 0; margin-top: 48px; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .post-list a { display: grid; gap: 6px; padding: 26px 0; border-bottom: 1px solid var(--line); }
  .post-list a:hover strong { color: var(--accent); }
  .post-list strong { font-size: clamp(20px, 2.6vw, 26px); line-height: 1.25; transition: color 0.2s; }
  .post-list span:not(.post-meta) { color: var(--ink-2); }
  .post-meta { color: var(--muted); }
  .pg h1.post-title { font-size: clamp(32px, 5.4vw, 56px); line-height: 1.05; text-transform: none; letter-spacing: -0.025em; font-variation-settings: 'wdth' 100; }
  .post-toc { margin: 40px 0 0; padding: 20px 24px; border: 1px solid var(--line-2); border-radius: var(--radius); background: var(--surface); }
  .post-toc p { color: var(--muted); }
  .post-toc ol { margin-top: 8px; gap: 4px; }
  .post-toc a:hover { color: var(--accent); }
  .prose { margin-top: 40px; font-size: 18px; line-height: 1.75; }
  .prose > * + * { margin-top: 1.1em; }
  .prose h2 { scroll-margin-top: calc(var(--nav-h) + 16px); }
  .prose h3 { scroll-margin-top: calc(var(--nav-h) + 16px); }
  .prose a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .prose strong { color: var(--ink); }
  .prose blockquote { border-left: 2px solid var(--accent); padding: 4px 0 4px 20px; color: var(--ink); font-style: italic; }
  .prose :not(pre) > code { font-family: var(--f-mono); font-size: 0.88em; background: var(--surface-2); border: 1px solid var(--line); padding: 1px 6px; border-radius: 6px; }
  .prose pre { font-family: var(--f-mono); font-size: 14px; line-height: 1.6; padding: 18px 20px; border-radius: 12px; border: 1px solid var(--line-2); overflow-x: auto; }
  .prose img { border-radius: 12px; border: 1px solid var(--line); height: auto; }
  .prose figcaption { color: var(--muted); font-size: 14px; margin-top: 8px; }
  .prose table { width: 100%; border-collapse: collapse; font-size: 15px; display: block; overflow-x: auto; }
  .prose th, .prose td { border-bottom: 1px solid var(--line-2); padding: 10px 12px; text-align: left; }
  .prose th { color: var(--ink); }
  .prose hr { border: 0; border-top: 1px solid var(--line); margin: 2.4em 0; }
  .post-foot { margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--line); display: grid; gap: 24px; }
  .post-foot .tags { margin-top: 0; }
  .post-author { display: flex; gap: 16px; align-items: flex-start; padding: 20px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .post-author .brand-mark { flex: none; }
  .post-foot .pg-ctas { margin-top: 0; }
  /* Previous/next links carry full post titles: let them wrap instead of forcing the page wider on phones. */
  .post-foot { grid-template-columns: minmax(0, 1fr); }
  .post-foot .pg-ctas .btn { height: auto; min-height: var(--h); max-width: 100%; padding-block: 14px; white-space: normal; text-align: left; line-height: 1.45; border-radius: 18px; }
  @media (max-width: 560px) { .pg dl { grid-template-columns: 1fr; } .pg dd { margin-bottom: 8px; } }
</style>
