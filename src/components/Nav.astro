---
import { person, site } from '../data/profile';
const links = [
  { href: '#about', label: 'About' },
  { href: '#capabilities', label: 'Capabilities' },
  { href: '#work', label: 'Work' },
  { href: '#research', label: 'Research' },
  { href: '#experience', label: 'Experience' },
  { href: '#contact', label: 'Contact' },
];
---
<header class="nav" data-nav>
  <div class="container nav-inner">
    <a href="#top" class="brand" aria-label={`${person.name} — home`}>
      <span class="brand-mark" aria-hidden="true">AA</span>
      <span class="brand-name">Abdula Adil <span>/ AI Engineer</span></span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => <a href={l.href} data-navlink>{l.label}</a>)}
      <a href="/blog/">Blog</a>
    </nav>
    <div class="nav-right">
      <span class="clock mono" title="Local time in Abu Dhabi"><i></i>AUH <time data-clock>--:--</time></span>
      <a class="btn primary" href="#contact" data-magnetic>Hire me</a>
      <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menu" data-menu-btn>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>
<div class="menu" id="menu" data-menu>
  <nav aria-label="Mobile">
    {links.map((l, i) => <a href={l.href} data-menu-link><small>0{i + 1}</small>{l.label}</a>)}
    <a href="/blog/"><small>0{links.length + 1}</small>Blog</a>
  </nav>
  <div class="menu-foot mono">
    <a href={`mailto:${person.email}`}>{person.email}</a>
    <a href={person.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
    <a href={site.cv} download>Download CV ↓</a>
  </div>
</div>
