---
import { projects } from '../data/profile';
import VoiceDemo from './demos/VoiceDemo.astro';
import PidDemo from './demos/PidDemo.astro';
import SqlDemo from './demos/SqlDemo.astro';
import RiskDemo from './demos/RiskDemo.astro';
const demos = { voice: VoiceDemo, pid: PidDemo, sql: SqlDemo, risk: RiskDemo } as const;
---
<section class="section" id="work" aria-labelledby="work-title">
  <div class="container">
    <div class="sec-head">
      <div>
        <div class="eyebrow mono"><b>03</b> Selected work</div>
        <h2 class="h2" id="work-title" data-split>Shipped, <span class="serif">in production</span></h2>
      </div>
      <p class="sec-sub" data-reveal>Enterprise AI and full-stack systems I’ve designed and built at Velosi Asset Integrity — each with a live, interactive sketch of how it works.</p>
    </div>

    <div class="stack" data-stack>
      {projects.map((p) => {
        const Demo = demos[p.demo as keyof typeof demos];
        return (
          <article class="case" data-case id={`work-${p.id}`} aria-labelledby={`case-${p.id}`}>
            <div class="case-info">
              <div class="case-head mono"><span class="case-idx">{p.index}</span><span>{p.kicker}</span></div>
              <h3 id={`case-${p.id}`}>{p.title}</h3>
              <p class="case-lede">{p.lede}</p>
              <ul>{p.bullets.map((b) => <li set:html={b} />)}</ul>
              <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
              <a class="case-more mono" href={`/projects/${p.id}/`}>Read the {p.title} case study →</a>
            </div>
            <Demo />
            <span class="case-dim" aria-hidden="true"></span>
          </article>
        );
      })}
    </div>
  </div>
</section>
