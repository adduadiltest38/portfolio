---
import DemoFrame from './DemoFrame.astro';
const sql = `SELECT i.ItemCode, i.Name, s.OnHand, i.ReorderLevel
FROM Inventory.Items i
JOIN Inventory.Stock s ON s.ItemId = i.Id
WHERE s.Warehouse = 'AUH-01'
  AND s.OnHand < i.ReorderLevel
ORDER BY s.OnHand;`;
const kw = ['SELECT', 'FROM', 'JOIN', 'ON', 'WHERE', 'AND', 'ORDER BY'];
const highlighted = sql
  .replace(/&/g, '&amp;').replace(/</g, '&lt;')
  .replace(new RegExp(`\\b(${kw.join('|')})\\b`, 'g'), '<span class="kw">$1</span>')
  .replace(/('[^']*')/g, '<span class="fn">$1</span>');
const rows = [
  ['VLV-1180', 'Ball valve 2" CL300', '3', '8'],
  ['GSK-0412', 'Spiral wound gasket 4"', '6', '20'],
  ['BLT-2207', 'Stud bolt B7 5/8"', '40', '120'],
];
---
<DemoFrame title="vail-erp · ask your data">
  <div class="term" data-sql data-sql-src={sql}>
    <div class="prompt"><span data-sql-q>Which items are below reorder level in the Abu Dhabi warehouse?</span><span class="caret"></span></div>
    <div class="meta"><span>FastAPI /v1/nl-query</span><span>Ollama + Semantic Kernel</span><span data-sql-ms>412 ms</span></div>
    <pre data-sql-pre set:html={highlighted}></pre>
    <table data-sql-table>
      <thead><tr><th>Item</th><th>Name</th><th>On hand</th><th>Reorder</th></tr></thead>
      <tbody>{rows.map((r) => <tr><td>{r[0]}</td><td>{r[1]}</td><td class="low">{r[2]}</td><td>{r[3]}</td></tr>)}</tbody>
    </table>
  </div>
</DemoFrame>

<script>
  import gsap from 'gsap';
  const root = document.querySelector<HTMLElement>('[data-sql]');
  if (root && !document.documentElement.classList.contains('reduced')) {
    const q = root.querySelector<HTMLElement>('[data-sql-q]')!;
    const pre = root.querySelector<HTMLElement>('[data-sql-pre]')!;
    const rows = root.querySelectorAll('[data-sql-table] tbody tr');
    const table = root.querySelector('[data-sql-table]')!;
    const qText = q.textContent ?? '';
    const html = pre.innerHTML;
    const src = root.dataset.sqlSrc ?? '';

    const type = (el: HTMLElement, text: string, dur: number) => {
      const o = { n: 0 };
      return gsap.to(o, { n: text.length, duration: dur, ease: 'none', onUpdate: () => { el.textContent = text.slice(0, Math.round(o.n)); } });
    };
    const tl = gsap.timeline({ repeat: -1, repeatDelay: 2, paused: true });
    tl.call(() => { q.textContent = ''; pre.textContent = ''; })
      .set(table, { autoAlpha: 0 })
      .set(rows, { autoAlpha: 0, x: -8 })
      .add(type(q, qText, 2.2))
      .to({}, { duration: 0.5 })
      .add(type(pre, src, 2.4))
      .call(() => { pre.innerHTML = html; })
      .to(table, { autoAlpha: 1, duration: 0.3 })
      .to(rows, { autoAlpha: 1, x: 0, stagger: 0.15, duration: 0.4 })
      .to({}, { duration: 3 });

    new IntersectionObserver(([e]) => (e.isIntersecting ? tl.play() : tl.pause()), { threshold: 0.3 }).observe(root);
  }
</script>
